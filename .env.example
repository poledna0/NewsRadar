APP_PORT=8000
APP_UID=1000
APP_GID=1000
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
DATABASE_URL=sqlite:///./data/newsradar.db
SEARXNG_URL=http://searxng:8080
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
TRANSLATION_DEFAULT_TARGET=pt-BR
COLLECTION_INTERVAL_MINUTES=30
MAX_RESULTS_PER_QUERY=10
MAX_RESULTS_PER_FEED=20
ARTICLE_MAX_AGE_HOURS=48
REQUEST_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=NewsRadar/0.1 (+self-hosted news aggregator)
MAX_QUERIES_PER_TOPIC=4
MAX_RESEARCH_RESULTS_PER_TOPIC=5
EXCLUDED_DOMAINS=nytimes.com,wsj.com,ft.com,bloomberg.com,forbes.com,medium.com,economist.com,wired.com,reuters.com,technologyreview.com,darkreading.com,csoonline.com,arstechnica.com,sciencedirect.com,springer.com,wiley.com,ieee.org,acm.org
AI_ARTICLES_PER_RUN=200
MAX_HTTP_RESPONSE_BYTES=8000000
MAX_REQUEST_BODY_BYTES=64000
COLLECT_ON_START=true
RESPECT_ROBOTS_TXT=true
